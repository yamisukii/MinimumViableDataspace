    "bestand":         { "tier": 2, "label": "Bestand",          "source": "ERP" },
    "verbrauch":       { "tier": 2, "label": "Verbrauch",        "source": "ERP" },
    "co2":             { "tier": 2, "label": "kWh/CO₂",          "source": "Infrastruktur" },
    "cad":             { "tier": 3, "label": "CAD / techn. Zeichnung", "source": "CAD" },
    "qdata":           { "tier": 3, "label": "Q-Data je Charge", "source": "Fertigung" }
  }
