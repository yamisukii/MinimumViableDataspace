meta {
  name: Initiate negotiation
  type: http
  seq: 2
}

post {
  url: {{CONSUMER_CP}}/api/mgmt/v4/contractnegotiations
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "ContractRequest",
    "counterPartyAddress": "{{PROVIDER_DSP}}",
    "counterPartyId": "{{PROVIDER_ID}}",
    "protocol": "dataspace-protocol-http:2025-1",
    "policy": {
      "@type": "Offer",
      "@id": "{{C2P_POLICY_ID}}",
      "assigner": "{{PROVIDER_ID}}",
      "permission": [],
      "prohibition": [],
      "obligation": {
        "action": "use",
        "constraint": {
          "leftOperand": "ManufacturerCredential.part_types",
          "operator": "eq",
          "rightOperand": "non_critical"
        }
      },
      "target": "asset-1"
    },
    "callbackAddresses": []
  }
}

script:pre-request {
  if(!(bru.getVar("C2P_POLICY_ID") !== undefined && bru.getVar("C2P_POLICY_ID") !== null)){
      throw new Error('C2P policy id is missing. Run "Request Catalog" first.');
  }
}

script:post-response {
  bru.setVar("C2P_CONTRACT_NEGOTIATION_ID", res.getBody()["@id"]);
  
  test("Status code is >=200 and <300", function () {
      expect(res.getStatus() < 300 && res.getStatus() >= 200).to.be.true
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
