meta {
  name: Download Data
  type: http
  seq: 7
}

get {
  url: {{PROVIDER_PUBLIC_URL}}/api/public
  body: none
  auth: none
}

headers {
  Authorization: {{C2P_AUTHORIZATION}}
}

script:pre-request {
  if(!(bru.getVar("C2P_AUTHORIZATION") !== undefined && bru.getVar("C2P_AUTHORIZATION") !== null)){
      throw new Error('C2P authorization token is missing. Run "Get EDR DataAddress" first.');
  }
  if(!(bru.getVar("C2P_DOWNLOAD_URL") !== undefined && bru.getVar("C2P_DOWNLOAD_URL") !== null)){
      const assetId = bru.getVar("C2P_ASSET_ID") || "asset-3";
      const fallbackUrl = assetId == "asset-3"
          ? bru.getVar("PROVIDER_PUBLIC_URL") + "/api/public"
          : bru.getVar("CONSUMER_PUBLIC_URL") + "/api/public";
      bru.setVar("C2P_DOWNLOAD_URL", fallbackUrl);
      console.log("C2P fallback download url", bru.getVar("C2P_DOWNLOAD_URL"));
  }
}

script:post-response {
  test("Status code is >=200 and <300", function () {
      expect(res.getStatus() < 300 && res.getStatus() >= 200).to.be.true
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
