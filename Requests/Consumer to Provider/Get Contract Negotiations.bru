meta {
  name: Get Contract Negotiations
  type: http
  seq: 3
}

post {
  url: {{CONSUMER_CP}}/api/mgmt/v4/contractnegotiations/request
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "QuerySpec"
  }
}

script:post-response {
  if(res.getStatus() < 300 && res.getStatus() >= 200 && res.getBody().length > 0){
      const assetId = bru.getVar("C2P_ASSET_ID") || "asset-3";
      bru.setVar("C2P_ASSET_ID", assetId);

      let negotiation;
      if (bru.getVar("C2P_CONTRACT_NEGOTIATION_ID") !== undefined && bru.getVar("C2P_CONTRACT_NEGOTIATION_ID") !== null) {
          negotiation = res.getBody().find((el) => el["@id"] == bru.getVar("C2P_CONTRACT_NEGOTIATION_ID"));
      }
      if (!negotiation || !negotiation["contractAgreementId"]) {
          negotiation = res.getBody()
              .filter((el) => el["assetId"] == assetId && el["state"] == "FINALIZED" && el["contractAgreementId"])
              .sort((a, b) => (b["createdAt"] || 0) - (a["createdAt"] || 0))[0];
      }
      if(negotiation){
          bru.setVar("C2P_CONTRACT_AGREEMENT_ID", negotiation["contractAgreementId"]);
          bru.setVar("C2P_CONTRACT_NEGOTIATION_ID", negotiation["@id"]);
          console.log("C2P negotiation id", bru.getVar("C2P_CONTRACT_NEGOTIATION_ID"));
          console.log("C2P agreement id", bru.getVar("C2P_CONTRACT_AGREEMENT_ID"));
      }
  }

  test("Status code is >=200 and <300", function () {
      expect(res.getStatus() < 300 && res.getStatus() >= 200).to.be.true
  });
  test("C2P contract agreement id is set", function(){
      expect(bru.getVar("C2P_CONTRACT_AGREEMENT_ID")).not.to.be.undefined
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
