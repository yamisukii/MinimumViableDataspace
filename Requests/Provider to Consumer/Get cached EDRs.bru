meta {
  name: Get cached EDRs
  type: http
  seq: 5
}

post {
  url: {{PROVIDER_CP}}/api/mgmt/v3/edrs/request
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "QuerySpec"
  }
}

script:post-response {
  if(res.getStatus() < 300 && res.getStatus() >= 200 && res.getBody().length > 0){
      const assetId = bru.getVar("P2C_ASSET_ID") || "consumer-asset-1";
      bru.setVar("P2C_ASSET_ID", assetId);
      const edr = res.getBody()
          .filter((entry) => entry["assetId"] == assetId)
          .sort((a, b) => (b["createdAt"] || 0) - (a["createdAt"] || 0))[0];
      if (!edr) {
          throw new Error(`No cached P2C EDR found for ${assetId}. Run "Initiate Transfer" first.`);
      }
      bru.setVar("P2C_TRANSFER_PROCESS_ID", edr["transferProcessId"]);
  }

  test("Status code is >=200 and <300", function () {
      expect(res.getStatus() < 300 && res.getStatus() >= 200).to.be.true
  });
  test("P2C transfer process id is set", function(){
      expect(bru.getVar("P2C_TRANSFER_PROCESS_ID")).not.to.be.undefined
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
