meta {
  name: Request Catalog
  type: http
  seq: 1
}

post {
  url: {{PROVIDER_CP}}/api/mgmt/v4/catalog/request
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "CatalogRequest",
    "counterPartyAddress": "{{CONSUMER_DSP}}",
    "counterPartyId": "{{CONSUMER_ID}}",
    "protocol": "dataspace-protocol-http:2025-1",
    "querySpec": {
      "offset": 0,
      "limit": 50
    }
  }
}

script:post-response {
  test("Status code is >=200 and <300", function () {
      expect(res.getStatus() < 300 && res.getStatus() >= 200).to.be.true

      const assetId = bru.getVar("P2C_ASSET_ID") || "consumer-asset-1";
      bru.setVar("P2C_ASSET_ID", assetId);
      const datasets = res.getBody()["dataset"] || [];
      const asset = datasets.find((ds) => ds["@id"] == assetId);
      if (!asset) {
          throw new Error(`${assetId} was not found in consumer catalog`);
      }

      const offer = asset["hasPolicy"][0];
      const rule = (offer["obligation"] && offer["obligation"][0]) || (offer["permission"] && offer["permission"][0]);
      const constraints = rule ? rule["constraint"] : [];
      const constraint = Array.isArray(constraints) ? constraints[0] : constraints;

      bru.setVar("P2C_POLICY_ID", offer["@id"]);
      bru.setVar("P2C_POLICY_LEFT_OPERAND", constraint["leftOperand"]);
      bru.setVar("P2C_POLICY_RIGHT_OPERAND", constraint["rightOperand"]);
      bru.setVar("P2C_CONTRACT_NEGOTIATION_ID", null);
      bru.setVar("P2C_CONTRACT_AGREEMENT_ID", null);
      bru.setVar("P2C_TRANSFER_PROCESS_ID", null);
      bru.setVar("P2C_AUTHORIZATION", null);
      bru.setVar("P2C_DOWNLOAD_URL", null);
      console.log("P2C asset id", assetId);
      console.log("P2C policy id", bru.getVar("P2C_POLICY_ID"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
